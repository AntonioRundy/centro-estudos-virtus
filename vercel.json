{
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/router?route=auth/:path*" },
    { "source": "/api/assets/:path*", "destination": "/api/router?route=assets/:path*" },
    { "source": "/api/admin/:path*", "destination": "/api/router?route=admin/:path*" },
    { "source": "/api/weekly-reports", "destination": "/api/router?route=weekly-reports" },
    { "source": "/api/radar", "destination": "/api/router?route=radar" },
    { "source": "/admin/provisioning", "destination": "/admin/provisioning/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
